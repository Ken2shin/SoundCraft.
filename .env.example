# =============================================================
# Copia este archivo a .env y rellena los valores.
#   Copiar en Windows:  copy .env.example .env
# =============================================================

# Clave de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=COPIA_TU_CLAVE_AQUI
GEMINI_MODEL=gemma-4-31b-it

# PostgreSQL (tras crear el esquema con sql/schema.sql)
#   Local:     postgresql://postgres:TU_PASSWORD_AQUI@localhost:5432/soundcraft_ai
#   Supabase:  usar el "Connection string" del panel (pooler puerto 6543). Los
#              caracteres especiales de la contraseña se codifican en URL
#              (@ = %40, * = %2A). El servidor aplica TLS automáticamente.
DATABASE_URL=postgresql://postgres:TU_PASSWORD_AQUI@localhost:5432/soundcraft_ai

# Supabase (credenciales del proyecto, opcional si usas Supabase)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# SECRETO (rol service_role; no exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# Secreto para firmar la cookie de sesión (48 bytes hex aleatorios)
SESSION_SECRET=GENERA_CON_NODE_ARRIBA

# Servicio Python de análisis
PYTHON_SERVICE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin SDK (servidor) - JSON de cuenta de servicio (OPCIONAL;
# sin él, los tokens se verifican con las claves públicas de Firebase)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase (navegador) - valores públicos de tu app de Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=